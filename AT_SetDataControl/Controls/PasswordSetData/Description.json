{
  "$schema": "../../.hmiframework/Schema/ControlDescription.Schema.json",
  "apiVersion": 1,
  "name": "PasswordSetData",
  "namespace": "TcHmi.Controls.SetDataFramework",
  "displayName": "PasswordSetData",
  "version": {
    "full": "1.0.0.0",
    "major": 1,
    "minor": 0,
    "revision": 0,
    "build": 0
  },
  "visible": true,
  "themeable": "Standard",
  "base": "TcHmi.Controls.System.TcHmiControl",
  "description": "Password version of StringSetData: shows one dot per character and edits it with a masked built-in keyboard that opens empty. Copy, cut, drag and context menu are refused. The maximum length comes from the data type of the bound symbol (STRING(n)).",
  "defaultDesignerEvent": ".onValueWritten",
  "properties": {
    "containerControl": false,
    "geometry": {
      "width": 400,
      "height": 50
    }
  },
  "template": "Template.html",
  "icons": [
    {
      "name": "Icons/16x16.png",
      "width": 16,
      "height": 16
    }
  ],
  "dependencyFiles": [
    {
      "name": "PasswordSetData.js",
      "type": "JavaScript",
      "description": "Contains all the main logic."
    },
    {
      "name": "Style.css",
      "type": "Stylesheet",
      "description": "Theme independent style"
    }
  ],
  "themes": {
    "Base": {
      "resources": [
        {
          "name": "Themes/Base/Style.css",
          "type": "Stylesheet",
          "description": "Theme dependent style"
        }
      ]
    },
    "Base-Dark": {
      "resources": [
        {
          "name": "Themes/Base-Dark/Style.css",
          "type": "Stylesheet",
          "description": "Theme dependent style"
        }
      ]
    }
  },
  "attributes": [
    {
      "name": "data-tchmi-password",
      "propertyName": "Password",
      "propertySetterName": "setPassword",
      "propertyGetterName": "getPassword",
      "displayName": "Password",
      "visible": true,
      "themeable": "None",
      "displayPriority": 5,
      "type": "tchmi:general#/definitions/String",
      "category": "PasswordSetData",
      "description": "Password symbol, e.g. %s%PLC1.MAIN.sPassword%/s%. Shown as one dot per character. Bound to a symbol the keyboard writes it directly (OneWay is enough); unbound the attribute itself is set. Readable like TcHmiPasswordInput::Text, e.g. %ctrl%Id::Password%/ctrl% as a login function parameter; write an empty string to clear it after use.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": null,
      "defaultValueInternal": null
    },
    {
      "name": "data-tchmi-lock",
      "propertyName": "Lock",
      "propertySetterName": "setLock",
      "propertyGetterName": "getLock",
      "displayName": "Lock",
      "visible": true,
      "themeable": "None",
      "displayPriority": 15,
      "type": "tchmi:general#/definitions/Boolean",
      "category": "PasswordSetData",
      "description": "TRUE: the value is read only and a lock icon is shown. A tap on the box shows Lock Description, if set. When bound, the control stays locked until the symbol delivers its first value.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": false,
      "defaultValueInternal": true
    },
    {
      "name": "data-tchmi-lock-description",
      "propertyName": "LockDescription",
      "propertySetterName": "setLockDescription",
      "propertyGetterName": "getLockDescription",
      "displayName": "Lock Description",
      "visible": true,
      "themeable": "None",
      "displayPriority": 20,
      "type": "tchmi:general#/definitions/String",
      "category": "PasswordSetData",
      "description": "Reason shown in a bubble when the locked value box is tapped. Empty: no bubble. Bind %l%...%/l% to localize.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": "",
      "defaultValueInternal": ""
    },
    {
      "name": "data-tchmi-hide",
      "propertyName": "Hide",
      "propertySetterName": "setHide",
      "propertyGetterName": "getHide",
      "displayName": "Hide",
      "visible": true,
      "themeable": "None",
      "displayPriority": 25,
      "type": "tchmi:general#/definitions/Boolean",
      "category": "PasswordSetData",
      "description": "TRUE: the control is collapsed (takes no space) and cannot be edited.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": false,
      "defaultValueInternal": false
    },
    {
      "name": "data-tchmi-text",
      "propertyName": "Text",
      "propertySetterName": "setText",
      "propertyGetterName": "getText",
      "displayName": "Text",
      "visible": true,
      "themeable": "None",
      "displayPriority": 10,
      "type": "tchmi:general#/definitions/String",
      "category": "PasswordSetData",
      "description": "Description on the left, also the keyboard title.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": null,
      "defaultValueInternal": ""
    },
    {
      "name": "data-tchmi-need-repeat",
      "propertyName": "NeedRepeat",
      "propertySetterName": "setNeedRepeat",
      "propertyGetterName": "getNeedRepeat",
      "displayName": "NeedRepeat",
      "visible": true,
      "themeable": "None",
      "displayPriority": 30,
      "type": "tchmi:general#/definitions/Boolean",
      "category": "PasswordSetData",
      "description": "TRUE: the keyboard asks for the new password twice (NewLabel / RepeatLabel) and writes only when both match. Also enables MinLength / MinSpecialCharacters.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": false,
      "defaultValueInternal": false
    },
    {
      "name": "data-tchmi-min-length",
      "propertyName": "MinLength",
      "propertySetterName": "setMinLength",
      "propertyGetterName": "getMinLength",
      "displayName": "MinLength",
      "visible": true,
      "themeable": "None",
      "displayPriority": 35,
      "type": "tchmi:general#/definitions/Number",
      "category": "PasswordSetData",
      "description": "NeedRepeat only: minimum number of characters of the new password. 0: no rule. Shown as a ↔ ≥n pill in the New box of the keyboard (tooltip MinLengthLabel), red ✗ until met; ✓ is refused until met.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": 0,
      "defaultValueInternal": 0
    },
    {
      "name": "data-tchmi-min-special-characters",
      "propertyName": "MinSpecialCharacters",
      "propertySetterName": "setMinSpecialCharacters",
      "propertyGetterName": "getMinSpecialCharacters",
      "displayName": "MinSpecialCharacters",
      "visible": true,
      "themeable": "None",
      "displayPriority": 40,
      "type": "tchmi:general#/definitions/Number",
      "category": "PasswordSetData",
      "description": "NeedRepeat only: minimum number of special characters (anything that is not a letter or a digit, space included) in the new password. 0: no rule. Shown as a #@ ≥n pill in the New box of the keyboard (tooltip MinSpecialCharactersLabel), red ✗ until met; ✓ is refused until met.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": 0,
      "defaultValueInternal": 0
    },
    {
      "name": "data-tchmi-string-width",
      "propertyName": "StringWidth",
      "propertySetterName": "setStringWidth",
      "propertyGetterName": "getStringWidth",
      "displayName": "StringWidth",
      "visible": true,
      "themeable": "Standard",
      "displayPriority": 5,
      "type": "tchmi:framework#/definitions/MeasurementValue",
      "category": "PasswordSetData Layout",
      "description": "Width of the value box. Default 180 px, the same as NumericSetData. In %: share of the control width.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": 180,
      "defaultValueInternal": 180
    },
    {
      "name": "data-tchmi-string-width-unit",
      "propertyName": "StringWidthUnit",
      "propertySetterName": "setStringWidthUnit",
      "propertyGetterName": "getStringWidthUnit",
      "refTo": "StringWidth",
      "displayName": "StringWidthUnit",
      "visible": true,
      "themeable": "Standard",
      "displayPriority": 10,
      "type": "tchmi:framework#/definitions/MeasurementUnit",
      "category": "PasswordSetData Layout",
      "description": "Could be 'px' or for relative sizing '%'.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": "px",
      "defaultValueInternal": "px"
    },
    {
      "name": "data-tchmi-text-width",
      "propertyName": "TextWidth",
      "propertySetterName": "setTextWidth",
      "propertyGetterName": "getTextWidth",
      "displayName": "TextWidth",
      "visible": true,
      "themeable": "Standard",
      "displayPriority": 15,
      "type": "tchmi:framework#/definitions/MeasurementValue",
      "category": "PasswordSetData Layout",
      "description": "Width of the text on the left. The value box is placed in the remaining width. In %: share of the control width minus the value box, so 100% leaves exactly the box.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": 100,
      "defaultValueInternal": 100
    },
    {
      "name": "data-tchmi-text-width-unit",
      "propertyName": "TextWidthUnit",
      "propertySetterName": "setTextWidthUnit",
      "propertyGetterName": "getTextWidthUnit",
      "refTo": "TextWidth",
      "displayName": "TextWidthUnit",
      "visible": true,
      "themeable": "Standard",
      "displayPriority": 20,
      "type": "tchmi:framework#/definitions/MeasurementUnit",
      "category": "PasswordSetData Layout",
      "description": "Could be 'px' or for relative sizing '%'.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": "%",
      "defaultValueInternal": "%"
    },
    {
      "name": "data-tchmi-text-alignment",
      "propertyName": "TextAlignment",
      "propertySetterName": "setTextAlignment",
      "propertyGetterName": "getTextAlignment",
      "displayName": "TextAlignment",
      "visible": true,
      "themeable": "Standard",
      "displayPriority": 25,
      "type": "tchmi:framework#/definitions/HorizontalAlignment",
      "category": "PasswordSetData Layout",
      "description": "Horizontal alignment of the text within TextWidth.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": "Left",
      "defaultValueInternal": "Left"
    },
    {
      "name": "data-tchmi-set-data-alignment",
      "propertyName": "SetDataAlignment",
      "propertySetterName": "setSetDataAlignment",
      "propertyGetterName": "getSetDataAlignment",
      "displayName": "SetDataAlignment",
      "visible": true,
      "themeable": "Standard",
      "displayPriority": 30,
      "type": "tchmi:framework#/definitions/HorizontalAlignment",
      "category": "PasswordSetData Layout",
      "description": "Horizontal alignment of the value box in the width left of the text.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": "Right",
      "defaultValueInternal": "Right"
    },
    {
      "name": "data-tchmi-string-alignment",
      "propertyName": "StringAlignment",
      "propertySetterName": "setStringAlignment",
      "propertyGetterName": "getStringAlignment",
      "displayName": "StringAlignment",
      "visible": true,
      "themeable": "Standard",
      "displayPriority": 35,
      "type": "tchmi:framework#/definitions/HorizontalAlignment",
      "category": "PasswordSetData Layout",
      "description": "Horizontal alignment of the dots inside the value box.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": "Center",
      "defaultValueInternal": "Center"
    },
    {
      "name": "data-tchmi-new-label",
      "propertyName": "NewLabel",
      "propertySetterName": "setNewLabel",
      "propertyGetterName": "getNewLabel",
      "displayName": "NewLabel",
      "visible": true,
      "themeable": "Standard",
      "displayPriority": 10,
      "type": "tchmi:general#/definitions/String",
      "category": "Keyboard",
      "description": "With NeedRepeat: keyboard label of the first field. Default %l%NEW_PASSWORD%/l%: the project localization text of the key NEW_PASSWORD, or NEW_PASSWORD if the project has none. A literal text or a %l%...%/l% binding replaces it.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": "%l%NEW_PASSWORD%/l%",
      "defaultValueInternal": "%l%NEW_PASSWORD%/l%"
    },
    {
      "name": "data-tchmi-repeat-label",
      "propertyName": "RepeatLabel",
      "propertySetterName": "setRepeatLabel",
      "propertyGetterName": "getRepeatLabel",
      "displayName": "RepeatLabel",
      "visible": true,
      "themeable": "Standard",
      "displayPriority": 20,
      "type": "tchmi:general#/definitions/String",
      "category": "Keyboard",
      "description": "With NeedRepeat: keyboard label of the second field. Default %l%REPEAT_PASSWORD%/l%: the project localization text of the key REPEAT_PASSWORD, or REPEAT_PASSWORD if the project has none. A literal text or a %l%...%/l% binding replaces it.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": "%l%REPEAT_PASSWORD%/l%",
      "defaultValueInternal": "%l%REPEAT_PASSWORD%/l%"
    },
    {
      "name": "data-tchmi-min-length-label",
      "propertyName": "MinLengthLabel",
      "propertySetterName": "setMinLengthLabel",
      "propertyGetterName": "getMinLengthLabel",
      "displayName": "MinLengthLabel",
      "visible": true,
      "themeable": "Standard",
      "displayPriority": 30,
      "type": "tchmi:general#/definitions/String",
      "category": "Keyboard",
      "description": "Tooltip of the MinLength rule pill (the pill shows only symbols); {0} is replaced by the number, e.g. 'Min. {0} characters'. Without {0} the number is appended. Default %l%PASSWORD_MIN_LENGTH%/l%: the project localization text of that key.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": "%l%PASSWORD_MIN_LENGTH%/l%",
      "defaultValueInternal": "%l%PASSWORD_MIN_LENGTH%/l%"
    },
    {
      "name": "data-tchmi-min-special-characters-label",
      "propertyName": "MinSpecialCharactersLabel",
      "propertySetterName": "setMinSpecialCharactersLabel",
      "propertyGetterName": "getMinSpecialCharactersLabel",
      "displayName": "MinSpecialCharactersLabel",
      "visible": true,
      "themeable": "Standard",
      "displayPriority": 40,
      "type": "tchmi:general#/definitions/String",
      "category": "Keyboard",
      "description": "Tooltip of the MinSpecialCharacters rule pill (the pill shows only symbols); {0} is replaced by the number, e.g. 'Min. {0} special characters'. Without {0} the number is appended. Default %l%PASSWORD_MIN_SPECIAL%/l%: the project localization text of that key.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": "%l%PASSWORD_MIN_SPECIAL%/l%",
      "defaultValueInternal": "%l%PASSWORD_MIN_SPECIAL%/l%"
    }
  ],
  "attributeCategories": [
    {
      "name": "PasswordSetData",
      "displayPriority": 50,
      "defaultCollapsed": false,
      "description": "Value and look of the set data."
    },
    {
      "name": "PasswordSetData Layout",
      "displayPriority": 60,
      "defaultCollapsed": false,
      "description": "Widths, alignments and sizes of the PasswordSetData parts."
    },
    {
      "name": "Keyboard",
      "displayPriority": 500,
      "defaultCollapsed": true,
      "description": "Texts of the keyboard."
    }
  ],
  "functions": [],
  "events": [
    {
      "name": ".onValueWritten",
      "displayName": ".onValueWritten",
      "visible": true,
      "displayPriority": 10,
      "category": "Control",
      "description": "Fired after the keyboard wrote a new password. No payload: the event never carries the password.",
      "heritable": true
    }
  ],
  "dataTypes": [
    {
      "schema": "Schema/Types.Schema.json"
    }
  ]
}
