      "category": "ButtonSetData",
      "description": "TRUE: the button cannot be pressed and shows a lock badge; its look does not change. A tap shows Lock Description, if set. When bound, the control stays locked until the symbol delivers its first value.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": false,
      "defaultValueInternal": true
    },
