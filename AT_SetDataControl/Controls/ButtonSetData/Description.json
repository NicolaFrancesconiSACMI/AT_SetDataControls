      "themeable": "Standard",
      "displayPriority": 70,
      "type": "tchmi:framework#/definitions/SolidColor",
      "category": "ButtonSetData",
      "description": "Colour of the lit button (glass bulb). The core, rim and glow are worked out from it. Empty: the theme colour (cyan).",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": null,
      "defaultValueInternal": null
    },
    {
      "name": "data-tchmi-button-background-color",
      "propertyName": "ButtonBackgroundColor",
      "propertySetterName": "setButtonBackgroundColor",
      "propertyGetterName": "getButtonBackgroundColor",
