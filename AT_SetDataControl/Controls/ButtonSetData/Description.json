      "visible": true,
      "themeable": "Standard",
      "displayPriority": 71,
      "type": "tchmi:framework#/definitions/SolidColor",
      "category": "ButtonSetData",
      "description": "Colour of the button when not lit (keycap body). Hover, pressed, outline and lip are worked out from it; text and lock badge turn white on a dark colour. Empty: the theme colour.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": null,
      "defaultValueInternal": null
