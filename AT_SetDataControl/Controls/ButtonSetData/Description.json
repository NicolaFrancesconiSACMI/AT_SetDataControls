      "themeable": "None",
      "displayPriority": 50,
      "type": "tchmi:general#/definitions/Boolean",
      "category": "ButtonSetData",
      "description": "TRUE: every write is added to the Audit Trail (SacmiTcHmiAuditTrailExt.AddEntry via TcHmi.Functions.SUtils.CallServerFunction). Toggle: 1 / 0. Standard: 1 per press.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": false,
      "defaultValueInternal": false
    },
