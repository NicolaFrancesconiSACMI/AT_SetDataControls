{
  "$schema": "../../.hmiframework/Schema/ControlDescription.Schema.json",
  "apiVersion": 1,
  "name": "ButtonSetData",
  "namespace": "TcHmi.Controls.SetDataFramework",
  "displayName": "ButtonSetData",
  "version": {
    "full": "1.0.0.0",
    "major": 1,
    "minor": 0,
    "revision": 0,
    "build": 0
  },
  "visible": true,
  "themeable": "Standard",
  "base": "TcHmi.Controls.System.TcHmiControl",
  "description": "Slate keycap button. Standard: TRUE while held. Toggle: inverts a BOOL on each click, optionally after a confirmation. Lock badges as the other SetDataFramework controls.",
  "defaultDesignerEvent": ".onButtonClick",
  "properties": {
    "containerControl": false,
    "geometry": {
      "width": 400,
      "height": 50
    }
  },
  "template": "Template.html",
  "icons": [
    {
      "name": "Icons/16x16.png",
      "width": 16,
      "height": 16
    }
  ],
  "dependencyFiles": [
    {
      "name": "ButtonSetData.js",
      "type": "JavaScript",
      "description": "Contains all the main logic."
    },
    {
      "name": "Style.css",
      "type": "Stylesheet",
      "description": "Theme independent style"
    }
  ],
  "themes": {
    "Base": {
      "resources": [
        {
          "name": "Themes/Base/Style.css",
          "type": "Stylesheet",
          "description": "Theme dependent style"
        }
      ]
    },
    "Base-Dark": {
      "resources": [
        {
          "name": "Themes/Base-Dark/Style.css",
          "type": "Stylesheet",
          "description": "Theme dependent style"
        }
      ]
    }
  },
  "attributes": [
    {
      "name": "data-tchmi-button-type",
      "propertyName": "ButtonType",
      "propertySetterName": "setButtonType",
      "propertyGetterName": "getButtonType",
      "displayName": "ButtonType",
      "visible": true,
      "themeable": "None",
      "displayPriority": 5,
      "type": "tchmi:framework#/definitions/TcHmi.Controls.SetDataFramework.ButtonSetData.ButtonType",
      "category": "ButtonSetData",
      "description": "Standard (monostable): Variable is TRUE while the button is held, FALSE on release. Toggle (bistable): each click writes the inverted Variable; ON = lit glass bulb, also when locked.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": "Standard",
      "defaultValueInternal": "Standard"
    },
    {
      "name": "data-tchmi-variable",
      "propertyName": "Variable",
      "propertySetterName": "setVariable",
      "propertyGetterName": "getVariable",
      "displayName": "Variable",
      "visible": true,
      "themeable": "None",
      "displayPriority": 10,
      "type": "tchmi:general#/definitions/Boolean",
      "category": "ButtonSetData",
      "description": "BOOL to write, e.g. %s%PLC1.MAIN.bStart%/s%. Bound to a symbol it is written directly; unbound the attribute itself is set. Standard without a binding: only the events.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "TwoWay",
      "heritable": true,
      "defaultValue": null,
      "defaultValueInternal": null
    },
