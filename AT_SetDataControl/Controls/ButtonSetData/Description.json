    {
      "name": ".onButtonPressed",
      "displayName": ".onButtonPressed",
      "visible": true,
      "displayPriority": 10,
      "category": "Control",
      "description": "Fired when the button is pressed (not when locked, hidden, disabled or without the operate right).",
      "heritable": true
    },
    {
      "name": ".onButtonReleased",
      "displayName": ".onButtonReleased",
      "visible": true,
      "displayPriority": 20,
      "category": "Control",
      "description": "Fired when the press ends: released, slid off, cancelled, locked or hidden while held. Always follows .onButtonPressed.",
      "heritable": true
    },
    {
      "name": ".onButtonClick",
      "displayName": ".onButtonClick",
      "visible": true,
      "displayPriority": 30,
      "category": "Control",
      "description": "Fired when the button is released over itself (a finger slid off does not click).",
      "heritable": true
    },
    {
      "name": ".onValueWritten",
      "displayName": ".onValueWritten",
      "visible": true,
      "displayPriority": 40,
      "category": "Control",
