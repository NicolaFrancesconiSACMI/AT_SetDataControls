      "themeable": "None",
      "displayPriority": 65,
      "type": "tchmi:general#/definitions/Boolean",
      "category": "ButtonSetData",
      "description": "Lights the button (glass bulb). Set or bound: only this decides, e.g. bind a feedback such as %s%PLC1.MAIN.bMotorRunning%/s%. Not set and not bound: the button is lit while Variable is TRUE.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": null,
      "defaultValueInternal": null
    },
