      "displayPriority": 25,
      "type": "tchmi:general#/definitions/String",
      "category": "ButtonSetData",
      "description": "Description on the left (shown when TextWidth > 0), also the confirm dialog title.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": null,
      "defaultValueInternal": ""
    },
