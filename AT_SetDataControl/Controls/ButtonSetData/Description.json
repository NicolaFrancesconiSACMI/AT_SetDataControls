      "propertySetterName": "setNeedConfirm",
      "propertyGetterName": "getNeedConfirm",
      "displayName": "NeedConfirm",
      "visible": true,
      "themeable": "None",
      "displayPriority": 45,
      "type": "tchmi:framework#/definitions/TcHmi.Controls.SetDataFramework.ButtonSetData.NeedConfirm",
      "category": "ButtonSetData",
      "description": "Toggle only (Standard ignores it): which clicks ask for a confirmation first: None, SwitchOn (FALSE -> TRUE), SwitchOff (TRUE -> FALSE) or All.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": "None",
      "defaultValueInternal": "None"
    },
