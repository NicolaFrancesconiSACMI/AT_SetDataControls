      "themeable": "None",
      "displayPriority": 60,
      "type": "tchmi:general#/definitions/String",
      "category": "ButtonSetData",
      "description": "Toggle only: buttons with the same group name on the page are exclusive. When one is switched ON, the others that are ON are written FALSE (also when locked). Empty: no group.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": "",
      "defaultValueInternal": ""
    },
