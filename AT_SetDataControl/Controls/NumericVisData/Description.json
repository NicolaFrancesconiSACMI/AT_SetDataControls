{
  "$schema": "../../.hmiframework/Schema/ControlDescription.Schema.json",
  "apiVersion": 1,
  "name": "NumericVisData",
  "namespace": "TcHmi.Controls.SetDataFramework",
  "displayName": "NumericVisData",
  "version": {
    "full": "1.0.0.0",
    "major": 1,
    "minor": 0,
    "revision": 0,
    "build": 0
  },
  "visible": true,
  "themeable": "Standard",
  "base": "TcHmi.Controls.System.TcHmiControl",
  "description": "Shows a numeric value, read only. Same look as NumericSetData. Limit values colour the value (and can make it blink) when the value crosses them.",
  "properties": {
    "containerControl": false,
    "geometry": {
      "width": 400,
      "height": 50
    }
  },
  "template": "Template.html",
  "icons": [
    {
      "name": "Icons/16x16.png",
      "width": 16,
      "height": 16
    }
  ],
  "dependencyFiles": [
    {
      "name": "NumericVisData.js",
      "type": "JavaScript",
      "description": "Contains all the main logic."
    },
    {
      "name": "Style.css",
      "type": "Stylesheet",
      "description": "Theme independent style"
    }
  ],
  "themes": {
    "Base": {
      "resources": [
        {
          "name": "Themes/Base/Style.css",
          "type": "Stylesheet",
          "description": "Theme dependent style"
        }
      ]
    },
    "Base-Dark": {
      "resources": [
        {
          "name": "Themes/Base-Dark/Style.css",
          "type": "Stylesheet",
          "description": "Theme dependent style"
        }
      ]
    }
  },
  "attributes": [
    {
      "name": "data-tchmi-value",
      "propertyName": "Value",
      "propertySetterName": "setValue",
      "propertyGetterName": "getValue",
      "displayName": "Value",
      "visible": true,
      "themeable": "None",
      "displayPriority": 5,
      "type": "tchmi:general#/definitions/Number",
      "category": "NumericVisData",
      "description": "Numeric value to show, e.g. %s%PLC1.MAIN.stSpeed::HmiValue%/s%.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": null,
      "defaultValueInternal": null
    },
    {
      "name": "data-tchmi-decimals",
      "propertyName": "Decimals",
      "propertySetterName": "setDecimals",
      "propertyGetterName": "getDecimals",
      "displayName": "Decimals",
      "visible": true,
      "themeable": "None",
      "displayPriority": 10,
      "type": "tchmi:general#/definitions/INT",
      "category": "NumericVisData",
      "description": "Decimals shown (0..10).",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": 3,
      "defaultValueInternal": 3
    },
    {
      "name": "data-tchmi-hide",
      "propertyName": "Hide",
      "propertySetterName": "setHide",
      "propertyGetterName": "getHide",
      "displayName": "Hide",
      "visible": true,
      "themeable": "None",
      "displayPriority": 30,
      "type": "tchmi:general#/definitions/Boolean",
      "category": "NumericVisData",
      "description": "TRUE: the control is collapsed (takes no space).",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": false,
      "defaultValueInternal": false
    },
    {
      "name": "data-tchmi-text",
      "propertyName": "Text",
      "propertySetterName": "setText",
      "propertyGetterName": "getText",
      "displayName": "Text",
      "visible": true,
      "themeable": "None",
      "displayPriority": 25,
      "type": "tchmi:general#/definitions/String",
      "category": "NumericVisData",
      "description": "Description on the left.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": null,
      "defaultValueInternal": ""
    },
    {
      "name": "data-tchmi-unit",
      "propertyName": "Unit",
      "propertySetterName": "setUnit",
      "propertyGetterName": "getUnit",
      "displayName": "Unit",
      "visible": true,
      "themeable": "None",
      "displayPriority": 15,
      "type": "tchmi:general#/definitions/String",
      "category": "NumericVisData",
      "description": "Unit shown after the value.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": null,
      "defaultValueInternal": ""
    },
    {
      "name": "data-tchmi-text-width",
      "propertyName": "TextWidth",
      "propertySetterName": "setTextWidth",
      "propertyGetterName": "getTextWidth",
      "displayName": "TextWidth",
      "visible": true,
      "themeable": "Standard",
      "displayPriority": 10,
      "type": "tchmi:framework#/definitions/MeasurementValue",
      "category": "NumericVisData Layout",
      "description": "Width of the text on the left. The value box is placed in the remaining width. In %: share of the control width minus the value box, so 100% leaves exactly the box.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": 100,
      "defaultValueInternal": 100
    },
    {
      "name": "data-tchmi-text-width-unit",
      "propertyName": "TextWidthUnit",
      "propertySetterName": "setTextWidthUnit",
      "propertyGetterName": "getTextWidthUnit",
      "refTo": "TextWidth",
      "displayName": "TextWidthUnit",
      "visible": true,
      "themeable": "Standard",
      "displayPriority": 20,
      "type": "tchmi:framework#/definitions/MeasurementUnit",
      "category": "NumericVisData Layout",
      "description": "Could be 'px' or for relative sizing '%'.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": "%",
      "defaultValueInternal": "%"
    },
    {
      "name": "data-tchmi-text-alignment",
      "propertyName": "TextAlignment",
      "propertySetterName": "setTextAlignment",
      "propertyGetterName": "getTextAlignment",
      "displayName": "TextAlignment",
      "visible": true,
      "themeable": "Standard",
      "displayPriority": 30,
      "type": "tchmi:framework#/definitions/HorizontalAlignment",
      "category": "NumericVisData Layout",
      "description": "Horizontal alignment of the text within TextWidth.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": "Left",
      "defaultValueInternal": "Left"
    },
    {
      "name": "data-tchmi-value-alignment",
      "propertyName": "ValueAlignment",
      "propertySetterName": "setValueAlignment",
      "propertyGetterName": "getValueAlignment",
      "displayName": "ValueAlignment",
      "visible": true,
      "themeable": "Standard",
      "displayPriority": 40,
      "type": "tchmi:framework#/definitions/HorizontalAlignment",
      "category": "NumericVisData Layout",
      "description": "Horizontal alignment of the value box (same size as in NumericSetData) in the width left of the text.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "defaultValue": "Right",
      "defaultValueInternal": "Right"
    },
    {
      "name": "data-tchmi-limits",
      "propertyName": "Limits",
      "propertySetterName": "setLimits",
      "propertyGetterName": "getLimits",
      "displayName": "Limits",
      "visible": true,
      "themeable": "None",
      "displayPriority": 20,
      "type": "tchmi:framework#/definitions/TcHmi.Controls.SetDataFramework.NumericVisData.LimitList",
      "category": "NumericVisData",
      "description": "Limit values (Limit, Sign, Color, CustomColor, Flashing). The first one whose condition holds colours the value text; put the most severe on top. Color: Default (no change), Red, Blue, Green, Orange or Custom (CustomColor). A Limit can be bound to a symbol.",
      "readOnly": false,
      "bindable": true,
      "defaultBindingMode": "OneWay",
      "heritable": true,
      "allowSymbolExpressionsInObject": true,
      "defaultValue": [],
      "defaultValueInternal": []
    }
  ],
  "attributeCategories": [
    {
      "name": "NumericVisData",
      "displayPriority": 50,
      "defaultCollapsed": false,
      "description": "Value and look of the visualized data."
    },
    {
      "name": "NumericVisData Layout",
      "displayPriority": 60,
      "defaultCollapsed": false,
      "description": "Widths, alignments and sizes of the NumericVisData parts."
    }
  ],
  "functions": [],
  "events": [],
  "dataTypes": [
    {
      "schema": "Schema/Types.Schema.json"
    }
  ]
}
