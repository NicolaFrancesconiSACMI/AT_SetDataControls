{
  "$schema": "../.hmiframework/Schema/FunctionDescription.Schema.json",
  "apiVersion": 1,
  "version": {
    "full": "1.0.0.0",
    "major": 1,
    "minor": 0,
    "revision": 0,
    "build": 0
  },
  "dependencyFiles": [
    {
      "name": "VirtualKeyboard.js",
      "type": "JavaScript",
      "description": "Shared keyboard implementation"
    },
    {
      "name": "OpenStringKeyboard.js",
      "type": "JavaScript",
      "description": ""
    }
  ],
  "function": {
    "name": "OpenStringKeyboard",
    "namespace": "TcHmi.Functions.SetDataFramework",
    "displayName": "OpenStringKeyboard",
    "visible": true,
    "description": "Opens the alphanumeric keyboard of the SetData package. It types into the focused text field (any control) and follows the focus; no Enter, the field commits when it loses focus; ✕ closes. Returns true if opened.",
    "category": "AT_SetData",
    "waitMode": "Synchronous",
    "injectContextObject": false,
    "returnValue": {
      "type": "tchmi:general#/definitions/Boolean"
    },
    "arguments": [
      {
        "name": "title",
        "displayName": "Title",
        "type": "tchmi:general#/definitions/String",
        "description": "Text in the title bar.",
        "defaultValue": "",
        "required": false,
        "bindable": true
      },
      {
        "name": "rejectSpecialCharacters",
        "displayName": "RejectSpecialCharacters",
        "type": "tchmi:general#/definitions/Boolean",
        "description": "true = only A-Z a-z 0-9 _ - . and space on the on-screen keys (same as StringSetData).",
        "defaultValue": false,
        "required": false,
        "bindable": true
      }
    ]
  }
}
