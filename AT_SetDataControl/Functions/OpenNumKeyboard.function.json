{
  "$schema": "../.hmiframework/Schema/FunctionDescription.Schema.json",
  "apiVersion": 1,
  "version": {
    "full": "1.0.0.0",
    "major": 1,
    "minor": 0,
    "revision": 0,
    "build": 0
  },
  "dependencyFiles": [
    {
      "name": "VirtualKeyboard.js",
      "type": "JavaScript",
      "description": "Shared keyboard implementation"
    },
    {
      "name": "OpenNumKeyboard.js",
      "type": "JavaScript",
      "description": ""
    }
  ],
  "function": {
    "name": "OpenNumKeyboard",
    "namespace": "TcHmi.Functions.SetDataFramework",
    "displayName": "OpenNumKeyboard",
    "visible": true,
    "description": "Opens the numeric keyboard of the SetData package. It types into the focused text field (any control) and follows the focus; no Enter, the field commits when it loses focus; ✕ closes. Returns true if opened.",
    "category": "AT_SetData",
    "waitMode": "Synchronous",
    "injectContextObject": false,
    "returnValue": {
      "type": "tchmi:general#/definitions/Boolean"
    },
    "arguments": [
      {
        "name": "title",
        "displayName": "Title",
        "type": "tchmi:general#/definitions/String",
        "description": "Text in the title bar.",
        "defaultValue": "",
        "required": false,
        "bindable": true
      },
      {
        "name": "decimals",
        "displayName": "Decimals",
        "type": "tchmi:general#/definitions/Number",
        "description": "Digits allowed after '.' on the on-screen keys. Empty = free; 0 = no '.'.",
        "defaultValue": null,
        "required": false,
        "bindable": true
      },
      {
        "name": "allowNegative",
        "displayName": "AllowNegative",
        "type": "tchmi:general#/definitions/Boolean",
        "description": "false = the ± key is greyed.",
        "defaultValue": true,
        "required": false,
        "bindable": true
      }
    ]
  }
}
